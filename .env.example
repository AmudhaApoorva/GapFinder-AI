# ==============================================================================
# GapFinder AI Environment Variables Template
# Copy this file to .env or set these in your Vercel Project Settings
# NOTE: Never commit actual API keys or secret passwords to Git.
# ==============================================================================

# Database Connection:
# - Local Development: SQLite (file:./dev.db)
# - Vercel / Production: PostgreSQL (e.g. Neon, Supabase, Vercel Postgres)
#   Example: postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="file:./dev.db"

# NextAuth Configuration:
# - Local Development: http://localhost:3000
# - Vercel / Production: https://your-project.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Generate a strong 32-character random string (e.g., via `openssl rand -base64 32`)
NEXTAUTH_SECRET="generate-a-random-secret-key-for-session-signing-32chars"

# ------------------------------------------------------------------------------
# LLM Generation Providers (Google Gemini API recommended):
# Set GEMINI_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY for Google Gemini.
# Other supported providers: Groq, OpenAI.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""

# ------------------------------------------------------------------------------
# Vector Embeddings Provider (Optional):
# - Set to "google" or "openai" if embedding API keys are provided.
# - Leave empty to use offline BM25 hybrid lexical ranking.
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=""
